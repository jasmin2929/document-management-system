# Database Configuration (PostgreSQL)
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=dms_password_change_me
POSTGRES_DB=dms_db
POSTGRES_PORT=5432

# REST API Configuration
REST_API_PORT=8081

# Web UI Configuration
WEB_UI_PORT=80

# Message Broker (RabbitMQ)
RABBITMQ_DEFAULT_USER=dms_user
RABBITMQ_DEFAULT_PASS=dms_password_change_me
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Object Storage (RustFS, S3-compatible)
RUSTFS_ACCESS_KEY=dms_storage_user
RUSTFS_SECRET_KEY=dms_storage_password_change_me
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
RUSTFS_BUCKET_NAME=dms-documents

# Search Engine (ElasticSearch)
ELASTICSEARCH_PORT=9200
ELASTIC_PASSWORD=elastic_password_change_me
KIBANA_PASSWORD=kibana_password_change_me
KIBANA_PORT=5601

# AI Integration (Google Gemini)
GEMINI_API_KEY=your_google_gemini_api_key_here